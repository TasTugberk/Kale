# Copy to .env (git-ignored) and adjust. Secrets don't belong here: they are Podman secrets.
# Keep plain KEY=VALUE lines without quotes or spaces: both compose and scripts/dev-db.sh read this file.

# Same image the tests use (PostgresFixture.Image). Multi-arch: runs natively on Apple Silicon.
POSTGRES_IMAGE=docker.io/library/postgres:18-alpine
POSTGRES_DB=kale_auth
POSTGRES_USER=kale
# Where AuthService reaches the database when it runs on your machine (dotnet run).
POSTGRES_HOST=localhost
# Host interface the database port is published on. 127.0.0.1 keeps it off your network.
POSTGRES_BIND_ADDRESS=127.0.0.1
# Host port. Change it if 5432 is already used on your machine.
POSTGRES_PORT=5432

# RabbitMQ (invalidation events). Its password is the Podman secret kale_rabbitmq_password.
RABBITMQ_IMAGE=docker.io/library/rabbitmq:4-alpine
RABBITMQ_USER=kale

# Host interface the apps are published on. 127.0.0.1 keeps them off your network.
APP_BIND_ADDRESS=127.0.0.1
# AuthService's address for browsers and for the other containers alike (a network alias), so tokens carry one
# issuer everywhere. Names under .localhost resolve to this machine in browsers and curl.
AUTHSERVICE_HOST=auth.kale.localhost
# Used inside the container too (the issuer's port must be the same on both sides).
AUTHSERVICE_PORT=8080
# gRPC over plain HTTP/2 (h2c, dev only). Only reachable inside the compose network.
AUTHSERVICE_GRPC_PORT=8081
SAMPLEAPP_PORT=8082

# Admin UI (Next.js). Its client secret and the first admin's password are Podman secrets.
ADMIN_UI_PORT=8083
# The first admin, created by scripts/dev-stack.sh (admin bootstrap).
ADMIN_USER=admin
