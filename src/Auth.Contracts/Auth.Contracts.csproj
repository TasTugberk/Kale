<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Kale.Auth.Client depends on it, so it ships as a package too (pack both; see docs/integration). -->
    <PackageId>Kale.Auth.Contracts</PackageId>
    <Description>Kale's gRPC and event contracts, used by Kale.Auth.Client.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Core.Api" />
    <!-- Build-time code generator only; not shipped with the package. -->
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both: AuthService implements the services, Auth.Client calls them. -->
    <Protobuf Include="Protos\*.proto" GrpcServices="Both" />
  </ItemGroup>

</Project>
