@page "/account/select-role"
@model AuthService.Pages.Account.SelectRoleModel
@inject IStringLocalizer<SharedText> T
@{
    ViewData["Title"] = T["ChooseRole"];
}
<h1>@T["ChooseRole"]</h1>
<form method="post">
    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl">
    @foreach (var role in Model.Roles)
    {
        <label class="choice"><input type="radio" name="RoleId" value="@role.Id" required> @role.Name</label>
    }
    <button type="submit">@T["Continue"]</button>
</form>
