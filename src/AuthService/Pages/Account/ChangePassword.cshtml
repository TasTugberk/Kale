@page "/account/change-password"
@model AuthService.Pages.Account.ChangePasswordModel
@inject IStringLocalizer<SharedText> T
@{
    ViewData["Title"] = T["ChangePassword"];
}
<h1>@T["ChangePassword"]</h1>
@if (Model.Changed)
{
    <p role="status">@T["PasswordChanged"]</p>
}
else
{
    @if (Model.Problem is not null)
    {
        <p role="alert">@T[Model.Problem]</p>
    }
    <p>@T["ChangePasswordText"]</p>
    @* No value attributes: a password never goes back into the page, not even after a refusal. *@
    <form method="post">
        <label>@T["CurrentPassword"] <input name="CurrentPassword" type="password" autocomplete="current-password" required autofocus></label>
        <label>@T["NewPassword"] <input name="NewPassword" type="password" autocomplete="new-password" required aria-describedby="password-rules"></label>
        <p id="password-rules" class="hint">@T["PasswordRules"]</p>
        <label>@T["RepeatNewPassword"] <input name="RepeatedPassword" type="password" autocomplete="new-password" required></label>
        <button type="submit">@T["ChangePassword"]</button>
    </form>
}
