{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Against the local stack (scripts/dev-stack.sh). Kale sends users back only to registered addresses: add
  // http://localhost:5299/signin-oidc and http://localhost:5299/signout-callback-oidc to the "sample" application
  // in the admin UI (Applications, then sample), and put its client secret into this project's user secrets
  // (dotnet user-secrets set Kale:ClientSecret ...; it is the Podman secret kale_sample_client_secret).
  "Kale": {
    "Authority": "http://auth.kale.localhost:8080/",
    "AllowInsecureHttpDevOnly": true
  },
  // SampleApp in the local stack.
  "SampleApi": "http://localhost:8082/"
}
