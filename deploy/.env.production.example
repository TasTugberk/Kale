# Settings for deploy/compose.production-example.yaml. Copy to deploy/.env (git-ignored; compose reads it from the
# compose file's folder) and adjust. Secrets don't belong here: they are Podman secrets (docs/production).
# Keep plain KEY=VALUE lines without quotes or spaces: both compose and the scripts read this file.

# Images. Build them from a release (podman build ..., see the guide) or pull them from your registry; a new
# version is a new tag here.
AUTHSERVICE_IMAGE=localhost/kale-authservice:1.0.0
ADMIN_UI_IMAGE=localhost/kale-admin-ui:1.0.0
SAMPLEAPP_IMAGE=localhost/kale-sampleapp:1.0.0
POSTGRES_IMAGE=docker.io/library/postgres:18-alpine
PROXY_IMAGE=docker.io/library/caddy:2-alpine

POSTGRES_DB=kale_auth
POSTGRES_USER=kale

# Public names. Names under .localhost resolve to this machine in browsers and curl, which is enough to try it on
# one computer; a real server uses its real DNS names (and certificates for them).
AUTH_HOST=auth.kale.localhost
ADMIN_UI_HOST=admin.kale.localhost
SAMPLE_HOST=sample.kale.localhost
# The proxy's HTTPS port, the same inside and outside the container (it is part of the issuer address). A real
# server uses 443 (the guide shows how rootless Podman can publish it); 9443 keeps clear of the dev stack.
PUBLIC_HTTPS_PORT=9443
# Host interface the proxy is published on: 0.0.0.0 on a server, 127.0.0.1 to keep the example off your network.
PUBLIC_BIND_ADDRESS=127.0.0.1

# The first admin, created once by `AuthService admin bootstrap`.
ADMIN_USER=admin
# The time zone the admin UI shows times in (an IANA name; UTC when empty).
ADMIN_UI_TIME_ZONE=Europe/Istanbul
